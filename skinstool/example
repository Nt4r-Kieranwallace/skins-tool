<?xml version="1.0" encoding="UTF-8"?>
<SetupGuide>
    <Title>Mod_Tool3.9.py</Title>
    <Section name="Resources">
        <Description>Create a folder named Resources to store the original game resource files.</Description>
        <Preparation>
            <Step>1. Create a folder named Resources.</Step>
            <Step>2. Prepare the original game resource files.</Step>
            <Step>3. Copy the required game resource directories into Resources.</Step>
            <Step>4. Preserve the original directory structure.</Step>
            <Step>5. Check that all required resource files are available.</Step>
        </Preparation>
        <RequiredDirectories>
            <Directory name="Ages">
                <Description>Contains game resource data and related files.</Description>
            </Directory>
            <Directory name="AssetRefs">
                <Description>Contains asset reference data used by the game.</Description>
            </Directory>
            <Directory name="Databin">
                <Description>Contains game database files and related data.</Description>
            </Directory>
            <Directory name="Prefab_Characters">
                <Description>Contains character prefab resources.</Description>
            </Directory>
        </RequiredDirectories>
        <FolderStructure>
            <Folder name="Resources">
                <Folder name="Ages"/>
                <Folder name="AssetRefs"/>
                <Folder name="Databin"/>
                <Folder name="Prefab_Characters"/>
            </Folder>
        </FolderStructure>
        <Purpose>This folder serves as the source directory for the original game resources required by the script.</Purpose>
    </Section>
    <Section name="Tasks">
        <Description>Create a separate folder named Tasks to receive skin images generated or extracted by the script.</Description>
        <Preparation>
            <Step>1. Create a folder named Tasks.</Step>
            <Step>2. Use this folder as the destination for skin images.</Step>
            <Step>3. Skin images must use the JPG or PNG format.</Step>
            <Step>4. Each image must be named using its corresponding skin ID.</Step>
        </Preparation>
        <SupportedFormats>
            <Format>.jpg</Format>
            <Format>.png</Format>
        </SupportedFormats>
        <NamingConvention>
            <Pattern>{skin_id}.jpg</Pattern>
            <Pattern>{skin_id}.png</Pattern>
        </NamingConvention>
        <Examples>
            <File>15009.jpg</File>
            <File>15010.png</File>
            <File>52414.jpg</File>
            <File>52417.png</File>
        </Examples>
        <Purpose>This folder is used to receive and organize skin images according to their skin IDs.</Purpose>
    </Section>
    <ErrorHandling>
        <Description>The script automatically generates an error log when an error occurs during execution.</Description>
        <ErrorLog>
            <FileName>horizon_error.log</FileName>
            <Purpose>Stores error details and diagnostic information for troubleshooting.</Purpose>
            <Behavior>Create the log file when an error occurs.</Behavior>
        </ErrorLog>
        <Success>
            <Condition>Execution completes successfully without errors.</Condition>
            <Behavior>No error log is generated.</Behavior>
        </Success>
    </ErrorHandling>
    <ZipOutput>
        <Description>Output ZIP files are automatically named according to the number of skin images processed.</Description>
        <SingleFile>
            <Condition>Exactly one skin image is processed.</Condition>
            <Input>{skin_id}.jpg or {skin_id}.png</Input>
            <Output>{files_name_jpg}.zip</Output>
            <Example>
                <Input>15009.jpg</Input>
                <Output>15009.zip</Output>
            </Example>
        </SingleFile>
        <MultipleFiles>
            <Condition>More than one skin image is processed.</Condition>
            <Output>Mod_{...}_Skin(s).zip</Output>
            <Behavior>Generate a combined ZIP archive instead of creating separate ZIP files for each image.</Behavior>
        </MultipleFiles>
    </ZipOutput>
    <Execution>
        <Step>1. Verify that the Resources folder has been created.</Step>
        <Step>2. Verify that Ages, AssetRefs, Databin and Prefab_Characters are inside Resources.</Step>
        <Step>3. Verify that the original game resources are in their correct directories.</Step>
        <Step>4. Verify that the Tasks folder is ready to receive skin images.</Step>
        <Step>5. Run Mod_Tool3.9.py using Python.</Step>
        <Step>6. Check the generated ZIP archive after processing.</Step>
        <Step>7. If an error occurs, check horizon_error.log for diagnostic information.</Step>
    </Execution>
</SetupGuide>
